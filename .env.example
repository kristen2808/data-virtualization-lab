# Copy to .env for a fresh setup; never overwrite an existing .env.
# Replace example/empty passwords locally. Never commit real credentials.
# Single-quote passwords containing $ or # to preserve their literal values.

# PostgreSQL server and Trino pg_lab connector.
POSTGRES_USER=lab_user
POSTGRES_PASSWORD=change_me

# SQL Server login used by the Trino mssql_lab connector (local PoC only).
MSSQL_USER=sa

# Shared by SQL Server's sa login and the Trino mssql_lab connector.
# Required: set a strong password locally; reuse the existing sa password
# when connecting to an already initialized SQL Server instance.
# Changing this value does not rotate the password in an existing database.
MSSQL_SA_PASSWORD=

# Trino user passwords and the internal shared secret are configured separately
# in ignored secrets/trino/ files. See README.md; do not add them here.
